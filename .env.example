# energy-ml-service — copy to .env for local overrides (never commit .env).
# Read by `python -m app`; real environment variables take precedence.

# Bind address and port. Keep 127.0.0.1: the service is private and is called
# only by auditor-backend (ML_SERVICE_URL there); browsers never call it.
HOST=127.0.0.1
PORT=8000
